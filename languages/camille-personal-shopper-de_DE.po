msgid "Camille"
msgstr "Camille"

#: includes/class-camille-ps-admin.php:46
msgid "Settings"
msgstr "Einstellungen"

#: includes/class-camille-ps-admin.php:118
msgid "You are not allowed to change these settings."
msgstr "Sie haben keine Berechtigung, diese Einstellungen zu ändern."

#: includes/class-camille-ps-admin.php:141
msgid "Please enter a valid email address."
msgstr "Bitte geben Sie eine gültige E-Mail-Adresse ein."

