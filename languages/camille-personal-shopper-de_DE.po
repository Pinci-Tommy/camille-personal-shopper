msgstr "Firmenname"

#: includes/class-camille-ps-admin.php:622
msgid "VAT number"
msgstr "USt-IdNr."

#: includes/class-camille-ps-admin.php:623
msgid "Tax code"
msgstr "Steuernummer"

#: includes/class-camille-ps-admin.php:623
