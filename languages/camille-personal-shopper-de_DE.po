msgid_plural "Last sync completed: %d items in Camille's catalog."
msgstr[0] "Letzte Synchronisierung abgeschlossen: %d Artikel in Camilles Katalog."
msgstr[1] "Letzte Synchronisierung abgeschlossen: %d Artikel in Camilles Katalog."

#. translators: %d: number of catalog items.
#: includes/class-camille-ps-admin.php:548
