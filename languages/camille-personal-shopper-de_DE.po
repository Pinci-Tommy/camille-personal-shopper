msgstr "Noch kein Konto? %s. Es ist kostenlos und enthält 300 Credits zum Ausprobieren von Camille."

#. translators: %s: sign-up link.
#: includes/class-camille-ps-admin.php:403
msgid "Create one on pinci.ai"
msgstr "Erstellen Sie eines auf pinci.ai"

#. translators: %s: email address.
#: includes/class-camille-ps-admin.php:415
#, php-format
msgid "Enter the 6-digit code sent to %s."
msgstr "Geben Sie den 6-stelligen Code ein, der an %s gesendet wurde."

