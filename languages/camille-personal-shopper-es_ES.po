#: includes/class-camille-ps-admin.php:297
#, php-format
msgid "We sent a 6-digit code to %s. It is valid for 15 minutes."
msgstr "Hemos enviado un código de 6 cifras a %s. Es válido durante 15 minutos."

#: includes/class-camille-ps-admin.php:299
msgid "Camille needs your shop to be served over HTTPS. Enable HTTPS and try again."
msgstr "Camille necesita que tu tienda funcione con HTTPS. Activa HTTPS e inténtalo de nuevo."

#: includes/class-camille-ps-admin.php:314
msgid "The code has expired. Please ask for a new one."
msgstr "El código ha caducado. Solicita uno nuevo."

#: includes/class-camille-ps-admin.php:318
msgid "The code has 6 digits."
msgstr "El código tiene 6 cifras."

#: includes/class-camille-ps-admin.php:352
msgid "Your shop is connected to Camille. Now send her your catalog."
msgstr "Tu tienda está conectada a Camille. Ahora envíale tu catálogo."

#: includes/class-camille-ps-admin.php:354
msgid "You received 300 free credits to get started."
msgstr "Has recibido 300 créditos gratuitos para empezar."

#. translators: %d: tries left.
#: includes/class-camille-ps-admin.php:360
#, php-format
msgid "Wrong code. %d try left."
msgid_plural "Wrong code. %d tries left."
msgstr[0] "Código incorrecto. Queda %d intento."
msgstr[1] "Código incorrecto. Quedan %d intentos."

#. translators: %s: sign-up link.
#: includes/class-camille-ps-admin.php:365
#, php-format
msgid "There is no Pinci account with this email. %s, then connect the shop again."
msgstr "No existe ninguna cuenta de Pinci con este correo. %s y después vuelve a conectar la tienda."

#. translators: %s: sign-up link.
#: includes/class-camille-ps-admin.php:365
msgid "Create your account"
msgstr "Crea tu cuenta"

#: includes/class-camille-ps-admin.php:369
msgid "Your Pinci account is not verified yet. Open the confirmation email Pinci sent you, then connect the shop again."
msgstr "Tu cuenta de Pinci aún no está verificada. Abre el correo de confirmación que te envió Pinci y después vuelve a conectar la tienda."

#: includes/class-camille-ps-admin.php:373
msgid "This email belongs to a Shopify store on Pinci. Use another Pinci account for your WooCommerce shop."
msgstr "Este correo pertenece a una tienda Shopify en Pinci. Usa otra cuenta de Pinci para tu tienda WooCommerce."

#: includes/class-camille-ps-admin.php:377
msgid "This website is already connected to another Pinci account. Contact support@pinci.ai."
msgstr "Este sitio ya está conectado a otra cuenta de Pinci. Escribe a support@pinci.ai."

#: includes/class-camille-ps-admin.php:381
msgid "This Pinci account is blocked. Contact support@pinci.ai."
msgstr "Esta cuenta de Pinci está bloqueada. Escribe a support@pinci.ai."

#: includes/class-camille-ps-admin.php:385
msgid "The code has expired or was tried too many times. Please ask for a new one."
msgstr "El código ha caducado o se ha intentado demasiadas veces. Solicita uno nuevo."

#: includes/class-camille-ps-admin.php:410
msgid "Settings saved, but Camille could not be switched on or off right now:"
msgstr "Ajustes guardados, pero ahora mismo no se ha podido activar o desactivar a Camille:"

#: includes/class-camille-ps-admin.php:415
msgid "Settings saved."
msgstr "Ajustes guardados."

#: includes/class-camille-ps-admin.php:432
msgid "Usage limits saved. They apply from the next message in the chat."
msgstr "Límites de uso guardados. Se aplican desde el próximo mensaje del chat."

#: includes/class-camille-ps-admin.php:434
msgid "One of the limits is out of range. Check the values and try again."
msgstr "Uno de los límites está fuera del rango permitido. Comprueba los valores e inténtalo de nuevo."

#: includes/class-camille-ps-admin.php:461 includes/class-camille-ps-admin.php:511
msgid "Camille could not use this photo. Use a JPEG, PNG or WebP image of up to 10 MB."
msgstr "Camille no ha podido usar esta foto. Usa una imagen JPEG, PNG o WebP de hasta 10 MB."

#: includes/class-camille-ps-admin.php:478
msgid "Personal shopper saved. Your customers see the new name and photo from their next visit."
msgstr "Personal shopper guardado. Tus clientes verán el nuevo nombre y la nueva foto desde su próxima visita."

#: includes/class-camille-ps-admin.php:482
msgid "The name must have 2 to 30 characters and contain only letters, spaces, apostrophes, dots and hyphens."
msgstr "El nombre debe tener de 2 a 30 caracteres y contener solo letras, espacios, apóstrofos, puntos y guiones."

#: includes/class-camille-ps-admin.php:484
msgid "Choose a photo that matches the gender, or your own photo."
msgstr "Elige una foto que corresponda al género, o tu propia foto."

#: includes/class-camille-ps-admin.php:486
msgid "Choose a photo from the gallery or upload your own."
msgstr "Elige una foto de la galería o sube la tuya."

#: includes/class-camille-ps-admin.php:551
