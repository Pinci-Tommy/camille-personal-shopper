msgstr "Prova con %s"

#. translators: %s: name of the personal shopper (Camille unless the shop renamed her).
#: includes/class-camille-ps-frontend.php:221
#, php-format
msgid "Ask %s"
msgstr "Chiedi a %s"

#: includes/class-camille-ps-customers.php:95 includes/class-camille-ps-customers.php:202 includes/class-camille-ps-customers.php:237 includes/class-camille-ps-admin.php:47 includes/class-camille-ps-admin.php:47 includes/class-camille-ps-admin.php:725 includes/class-camille-ps-catalog-filter.php:278
msgid "Camille"
msgstr "Camille"

#: includes/class-camille-ps-customers.php:96
msgid "Preview"
msgstr "Anteprima"

#: includes/class-camille-ps-customers.php:98
msgid "This customer can see Camille"
msgstr "Questo cliente può vedere Camille"

#: includes/class-camille-ps-customers.php:99
msgid "Applies when Camille is visible to \"Administrators and chosen customers\" (WooCommerce > Camille)."
msgstr "Vale quando Camille è visibile ad \"Amministratori e clienti scelti\" (WooCommerce > Camille)."

#: includes/class-camille-ps-customers.php:141
msgid "Show Camille"
msgstr "Mostra Camille"

#: includes/class-camille-ps-customers.php:142
