msgid_plural "%d customers can now see Camille."
msgstr[0] "Ora %d cliente può vedere Camille."
msgstr[1] "Ora %d clienti possono vedere Camille."

#. translators: %d: number of users.
#: includes/class-camille-ps-customers.php:190
#, php-format
msgid "%d customer no longer sees Camille."
msgid_plural "%d customers no longer see Camille."
msgstr[0] "%d cliente non vede più Camille."
msgstr[1] "%d clienti non vedono più Camille."

#: includes/class-camille-ps-customers.php:219
msgid "Sees Camille"
msgstr "Vede Camille"

#: includes/class-camille-ps-admin.php:57
msgid "Settings"
msgstr "Impostazioni"

#. translators: 1: products Camille will know, 2: products that can be sent.
#: includes/class-camille-ps-admin.php:114 includes/class-camille-ps-admin.php:937
#, php-format
msgid "Camille will know %1$s of %2$s products."
msgstr "Camille conoscerà %1$s prodotti su %2$s."

#: includes/class-camille-ps-admin.php:116
msgid "I am browsing your catalog…"
msgstr "Sto sfogliando il Suo catalogo…"

#: includes/class-camille-ps-admin.php:117
msgid "I am saving your products…"
msgstr "Sto salvando i Suoi prodotti…"

#: includes/class-camille-ps-admin.php:118
msgid "I am studying your pieces…"
msgstr "Sto studiando i Suoi capi…"

#: includes/class-camille-ps-admin.php:119
msgid "I have studied your pieces. I am ready!"
msgstr "Ho studiato i Suoi capi. Sono pronta!"

#: includes/class-camille-ps-admin.php:120
msgid "Your catalog is up to date."
msgstr "Il Suo catalogo è aggiornato."

#: includes/class-camille-ps-admin.php:121
msgid "The sync stopped."
msgstr "La sincronizzazione si è fermata."

#: includes/class-camille-ps-admin.php:125
msgid "I read names, prices, sizes and colours of every product…"
msgstr "Leggo nomi, prezzi, taglie e colori di ogni prodotto…"

#: includes/class-camille-ps-admin.php:126
msgid "I collect the photos of your products…"
msgstr "Raccolgo le foto dei Suoi prodotti…"

#: includes/class-camille-ps-admin.php:129
msgid "I put every colour of a product in my catalog as a separate piece…"
msgstr "Inserisco ogni colore di un prodotto nel mio catalogo come un capo a sé…"

#: includes/class-camille-ps-admin.php:130
msgid "I check that every piece has a price and a photo…"
msgstr "Controllo che ogni capo abbia un prezzo e una foto…"

#: includes/class-camille-ps-admin.php:133
msgid "I look at the photo of every piece, one by one…"
msgstr "Guardo la foto di ogni capo, uno per uno…"

#: includes/class-camille-ps-admin.php:134
msgid "I look at colours and shades to understand what goes well together…"
msgstr "Osservo colori e sfumature per capire cosa sta bene insieme…"

#: includes/class-camille-ps-admin.php:135
msgid "I study the fabrics: linen, wool, silk, denim…"
msgstr "Studio i tessuti: lino, lana, seta, denim…"

#: includes/class-camille-ps-admin.php:136
msgid "I look at cuts and lengths to suggest the right fit…"
msgstr "Guardo tagli e lunghezze per consigliare la vestibilità giusta…"

#: includes/class-camille-ps-admin.php:137
msgid "I think about the right occasions: office, dinner, ceremony, weekend…"
msgstr "Penso alle occasioni giuste: ufficio, cena, cerimonia, weekend…"

#: includes/class-camille-ps-admin.php:138
msgid "I imagine the first outfits for your customers…"
msgstr "Immagino i primi abbinamenti per i Suoi clienti…"

#. translators: 1: products sent, 2: products to send.
#: includes/class-camille-ps-admin.php:142
#, php-format
msgid "%1$s of %2$s products read"
msgstr "%1$s prodotti letti su %2$s"

#. translators: 1: pieces saved, 2: pieces to save.
#: includes/class-camille-ps-admin.php:144
#, php-format
msgid "%1$s of %2$s pieces saved"
msgstr "%1$s capi salvati su %2$s"

#. translators: %s: minutes.
#: includes/class-camille-ps-admin.php:146
#, php-format
msgid "About %s minutes left"
msgstr "Circa %s minuti alla fine"

#. translators: %s: minutes.
#: includes/class-camille-ps-admin.php:147
msgid "About a minute left"
msgstr "Circa un minuto alla fine"

#: includes/class-camille-ps-admin.php:148
msgid "Almost done…"
msgstr "Quasi finito…"

#: includes/class-camille-ps-admin.php:149
msgid "Pinci is busy: the import will continue by itself in a few minutes."
msgstr "Pinci è occupato. L’importazione riprenderà da sola tra qualche minuto."

#: includes/class-camille-ps-admin.php:150
msgid "You can leave this page: the sync continues in the background."
msgstr "Può lasciare questa pagina. La sincronizzazione continua in background."

#: includes/class-camille-ps-admin.php:151 includes/class-camille-ps-admin.php:799
msgid "Sync the catalog"
msgstr "Sincronizza il catalogo"

#: includes/class-camille-ps-admin.php:153
msgid "Reading"
msgstr "Lettura"

#: includes/class-camille-ps-admin.php:154
msgid "Saving"
msgstr "Salvataggio"

#: includes/class-camille-ps-admin.php:155
msgid "Studying"
msgstr "Studio dei capi"

#. translators: %s: number of pieces.
#: includes/class-camille-ps-admin.php:172
#, php-format
msgid "%s piece in Camille's catalog."
msgid_plural "%s pieces in Camille's catalog."
msgstr[0] "%s capo nel catalogo di Camille."
msgstr[1] "%s capi nel catalogo di Camille."

#. translators: %d: number of items.
#: includes/class-camille-ps-admin.php:174
#, php-format
msgid "%d item left out"
msgid_plural "%d items left out"
msgstr[0] "%d articolo escluso"
msgstr[1] "%d articoli esclusi"

#: includes/class-camille-ps-admin.php:245
msgid "You are not allowed to change these settings."
msgstr "Non ha i permessi per modificare queste impostazioni."

#: includes/class-camille-ps-admin.php:270
msgid "Please enter a valid email address."
msgstr "Inserisca un indirizzo email valido."

#. translators: %s: email address.
#: includes/class-camille-ps-admin.php:285
#, php-format
msgid "We sent a 6-digit code to %s. It is valid for 15 minutes."
msgstr "Abbiamo inviato un codice di 6 cifre a %s. È valido per 15 minuti."

#: includes/class-camille-ps-admin.php:287
msgid "Camille needs your shop to be served over HTTPS. Enable HTTPS and try again."
msgstr "Camille richiede che il negozio sia servito in HTTPS. Attivi HTTPS e riprovi."

#: includes/class-camille-ps-admin.php:302
msgid "The code has expired. Please ask for a new one."
msgstr "Il codice è scaduto. Ne chieda uno nuovo."

#: includes/class-camille-ps-admin.php:306
msgid "The code has 6 digits."
msgstr "Il codice è di 6 cifre."

#: includes/class-camille-ps-admin.php:339
msgid "Your shop is connected to Camille. Now send her your catalog."
msgstr "Il negozio è collegato a Camille. Ora le invii il catalogo."

#: includes/class-camille-ps-admin.php:341
msgid "You received 300 free credits to get started."
msgstr "Ha ricevuto 300 crediti gratuiti per iniziare."

#. translators: %d: tries left.
#: includes/class-camille-ps-admin.php:347
#, php-format
msgid "Wrong code. %d try left."
msgid_plural "Wrong code. %d tries left."
msgstr[0] "Codice errato. Resta %d tentativo."
msgstr[1] "Codice errato. Restano %d tentativi."

#. translators: %s: sign-up link.
#: includes/class-camille-ps-admin.php:352
#, php-format
msgid "There is no Pinci account with this email. %s, then connect the shop again."
msgstr "Non esiste un account Pinci con questa email. %s, poi colleghi di nuovo il negozio."

#. translators: %s: sign-up link.
#: includes/class-camille-ps-admin.php:352
msgid "Create your account"
msgstr "Crei il Suo account"

#: includes/class-camille-ps-admin.php:356
msgid "Your Pinci account is not verified yet. Open the confirmation email Pinci sent you, then connect the shop again."
msgstr "Il Suo account Pinci non è ancora verificato. Apra l’email di conferma che Pinci Le ha inviato, poi colleghi di nuovo il negozio."

#: includes/class-camille-ps-admin.php:360
msgid "This email belongs to a Shopify store on Pinci. Use another Pinci account for your WooCommerce shop."
msgstr "Questa email appartiene a un negozio Shopify su Pinci. Per il negozio WooCommerce usi un altro account Pinci."

#: includes/class-camille-ps-admin.php:364
msgid "This website is already connected to another Pinci account. Contact support@pinci.ai."
msgstr "Questo sito è già collegato a un altro account Pinci. Scriva a support@pinci.ai."

#: includes/class-camille-ps-admin.php:368
msgid "This Pinci account is blocked. Contact support@pinci.ai."
msgstr "Questo account Pinci è bloccato. Scriva a support@pinci.ai."

#: includes/class-camille-ps-admin.php:372
msgid "The code has expired or was tried too many times. Please ask for a new one."
msgstr "Il codice è scaduto o è stato provato troppe volte. Ne chieda uno nuovo."

#: includes/class-camille-ps-admin.php:396
msgid "Settings saved, but Camille could not be switched on or off right now:"
msgstr "Impostazioni salvate, ma in questo momento non è stato possibile accendere o spegnere Camille."

#: includes/class-camille-ps-admin.php:401
msgid "Settings saved."
msgstr "Impostazioni salvate."

#: includes/class-camille-ps-admin.php:418
msgid "Usage limits saved. They apply from the next message in the chat."
msgstr "Limiti d’uso salvati. Valgono dal prossimo messaggio in chat."

#: includes/class-camille-ps-admin.php:420
msgid "One of the limits is out of range. Check the values and try again."
msgstr "Uno dei limiti è fuori dall’intervallo consentito. Controlli i valori e riprovi."

#: includes/class-camille-ps-admin.php:447 includes/class-camille-ps-admin.php:496
msgid "Camille could not use this photo. Use a JPEG, PNG or WebP image of up to 10 MB."
msgstr "Camille non è riuscita a usare questa foto. Usi un’immagine JPEG, PNG o WebP fino a 10 MB."

#: includes/class-camille-ps-admin.php:463
msgid "Personal shopper saved. Your customers see the new name and photo from their next visit."
msgstr "Personal shopper salvata. I Suoi clienti vedranno il nuovo nome e la nuova foto dalla prossima visita."

#: includes/class-camille-ps-admin.php:467
msgid "The name must have 2 to 30 characters and contain only letters, spaces, apostrophes, dots and hyphens."
msgstr "Il nome deve avere da 2 a 30 caratteri e contenere solo lettere, spazi, apostrofi, punti e trattini."

#: includes/class-camille-ps-admin.php:469
msgid "Choose a photo that matches the gender, or your own photo."
msgstr "Scelga una foto adatta al genere scelto, oppure la Sua foto."

#: includes/class-camille-ps-admin.php:471
msgid "Choose a photo from the gallery or upload your own."
msgstr "Scelga una foto dalla galleria o carichi la Sua."

#: includes/class-camille-ps-admin.php:536
msgid "Selection saved. Sync the catalog to update Camille."
msgstr "Selezione salvata. Sincronizzi il catalogo per aggiornare Camille."

#: includes/class-camille-ps-admin.php:543
msgid "Selection saved. Camille is updating her catalog."
msgstr "Selezione salvata. Camille sta aggiornando il suo catalogo."

#: includes/class-camille-ps-admin.php:562
msgid "Billing details saved."
msgstr "Dati di fatturazione salvati."

#: includes/class-camille-ps-admin.php:574
msgid "Some billing details are missing or not valid. Check the marked fields."
msgstr "Alcuni dati di fatturazione mancano o non sono validi. Controlli i campi evidenziati."

#: includes/class-camille-ps-admin.php:587
msgid "Catalog sync started. It runs in the background: you can leave this page."
msgstr "Sincronizzazione del catalogo avviata. Procede in background, può lasciare questa pagina."

#: includes/class-camille-ps-admin.php:602
msgid "The shop was disconnected here, but Camille could not be told. Write to support@pinci.ai to close it on Pinci too."
msgstr "Il negozio è stato scollegato qui, ma non è stato possibile avvisare Camille. Scriva a support@pinci.ai per chiuderlo anche su Pinci."

#: includes/class-camille-ps-admin.php:604
msgid "The shop is disconnected. Camille no longer appears on it."
msgstr "Il negozio è scollegato. Camille non vi compare più."

#: includes/class-camille-ps-admin.php:635
msgid "Camille, your AI personal shopper"
msgstr "Camille, la Sua personal shopper AI"

#: includes/class-camille-ps-admin.php:664
msgid "Connect your shop"
msgstr "Colleghi il negozio"

#: includes/class-camille-ps-admin.php:666
msgid "Camille works with a Pinci account. Enter the email of your account: we will send you a code to confirm it is yours."
msgstr "Camille funziona con un account Pinci. Inserisca l’email del Suo account. Le invieremo un codice per confermare che è Suo."

#: includes/class-camille-ps-admin.php:670
msgid "Pinci account email"
msgstr "Email dell’account Pinci"

#: includes/class-camille-ps-admin.php:672
msgid "Send the code"
msgstr "Invia il codice"

#. translators: %s: sign-up link.
#: includes/class-camille-ps-admin.php:678
#, php-format
msgid "No account yet? %s, it is free and includes 300 credits to try Camille."
msgstr "Non ha ancora un account? %s. È gratuito e include 300 crediti per provare Camille."

#. translators: %s: sign-up link.
#: includes/class-camille-ps-admin.php:679
msgid "Create one on pinci.ai"
msgstr "Lo crei su pinci.ai"

#. translators: %s: email address.
#: includes/class-camille-ps-admin.php:691
#, php-format
msgid "Enter the 6-digit code sent to %s."
msgstr "Inserisca il codice di 6 cifre inviato a %s."

#: includes/class-camille-ps-admin.php:695
msgid "Code"
msgstr "Codice"

#: includes/class-camille-ps-admin.php:697
msgid "Connect the shop"
msgstr "Collega il negozio"

#: includes/class-camille-ps-admin.php:703
msgid "Use another email or send a new code"
msgstr "Usa un’altra email o invia un nuovo codice"

#: includes/class-camille-ps-admin.php:719
msgid "Status"
msgstr "Stato"

#: includes/class-camille-ps-admin.php:721
msgid "Camille is temporarily paused by Pinci. Your shop keeps working normally."
msgstr "Camille è momentaneamente in pausa da parte di Pinci. Il negozio continua a funzionare normalmente."

#: includes/class-camille-ps-admin.php:724
msgid "Pinci account"
msgstr "Account Pinci"

#: includes/class-camille-ps-admin.php:725
msgid "On"
msgstr "Accesa"

#: includes/class-camille-ps-admin.php:725 includes/class-camille-ps-admin.php:1004
msgid "Off"
msgstr "Spenta"

#: includes/class-camille-ps-admin.php:727
msgid "Credits left"
msgstr "Crediti rimasti"

#: includes/class-camille-ps-admin.php:729
msgid "Buy credits"
msgstr "Acquista crediti"

#: includes/class-camille-ps-admin.php:733
msgid "Before buying credits, enter your billing details so we can send you the invoice."
msgstr "Prima di acquistare crediti inserisca i dati di fatturazione, così possiamo inviarLe la fattura."

#: includes/class-camille-ps-admin.php:733 includes/class-camille-ps-admin.php:1121
msgid "Billing details"
msgstr "Dati di fatturazione"

#: includes/class-camille-ps-admin.php:736
msgid "Last catalog sync"
msgstr "Ultima sincronizzazione del catalogo"

#: includes/class-camille-ps-admin.php:736
msgid "Never"
msgstr "Mai"

#: includes/class-camille-ps-admin.php:749 includes/class-camille-ps-admin.php:750
msgid "Your catalog is over the 5,000 product limit."
msgstr "Il catalogo supera il limite di 5.000 prodotti."

#: includes/class-camille-ps-admin.php:751
msgid "No product could be sent: check that your products have a price and a photo."
msgstr "Non è stato possibile inviare alcun prodotto. Controlli che i prodotti abbiano un prezzo e una foto."

#: includes/class-camille-ps-admin.php:752
msgid "Pinci was not reachable for a long time. Start the sync again."
msgstr "Pinci non è stato raggiungibile a lungo. Avvii di nuovo la sincronizzazione."

#: includes/class-camille-ps-admin.php:753
msgid "Camille was not reachable for a long time. Start the sync again."
msgstr "Camille non è stata raggiungibile a lungo. Avvii di nuovo la sincronizzazione."

#: includes/class-camille-ps-admin.php:754
msgid "Camille does not find this shop any more. Disconnect and connect it again."
msgstr "Camille non trova più questo negozio. Lo scolleghi e lo colleghi di nuovo."

#: includes/class-camille-ps-admin.php:755
msgid "The sync stopped halfway. Start it again."
msgstr "La sincronizzazione si è fermata a metà. La avvii di nuovo."

#: includes/class-camille-ps-admin.php:756
msgid "A newer sync replaced this one."
msgstr "Una sincronizzazione più recente ha sostituito questa."

#: includes/class-camille-ps-admin.php:758
msgid "The sync stopped because of an error. Start it again; if it happens again write to support@pinci.ai."
msgstr "La sincronizzazione si è fermata per un errore. La avvii di nuovo. Se succede ancora scriva a support@pinci.ai."

#: includes/class-camille-ps-admin.php:769
msgid "no name"
msgstr "senza nome"

#: includes/class-camille-ps-admin.php:770
msgid "no price"
msgstr "senza prezzo"

#: includes/class-camille-ps-admin.php:771
msgid "no photo"
msgstr "senza foto"

#: includes/class-camille-ps-admin.php:772
msgid "product address not valid"
msgstr "indirizzo del prodotto non valido"

#: includes/class-camille-ps-admin.php:773
msgid "currency not valid"
msgstr "valuta non valida"

#: includes/class-camille-ps-admin.php:775
msgid "data not valid"
msgstr "dati non validi"

#: includes/class-camille-ps-admin.php:783
msgid "Catalog"
msgstr "Catalogo"

#: includes/class-camille-ps-admin.php:784
msgid "Camille only suggests products she knows. Sync again after adding products or changing prices, so she always shows what you sell."
msgstr "Camille propone solo i prodotti che conosce. Sincronizzi di nuovo dopo aver aggiunto prodotti o cambiato prezzi, così mostra sempre quello che vende."

#: includes/class-camille-ps-admin.php:795
msgid "Reload the page to see how the sync is going."
msgstr "Ricarichi la pagina per vedere a che punto è la sincronizzazione."

#: includes/class-camille-ps-admin.php:799
msgid "Restart the sync"
msgstr "Riavvia la sincronizzazione"

#: includes/class-camille-ps-admin.php:810
msgid "Customise Camille"
msgstr "Personalizza Camille"

#: includes/class-camille-ps-admin.php:811
msgid "Give your personal shopper the name and the face that suit your shop. Customers see them in the chat and on the chat button."
msgstr "Dia alla Sua personal shopper il nome e il volto più adatti al negozio. I clienti li vedono nella chat e sul pulsante della chat."

#: includes/class-camille-ps-admin.php:814
msgid "The personal shopper settings cannot be read right now. Please try again in a few minutes."
msgstr "Al momento non è possibile leggere le impostazioni della personal shopper. Riprovi tra qualche minuto."

#: includes/class-camille-ps-admin.php:827
msgid "Name"
msgstr "Nome"

#: includes/class-camille-ps-admin.php:828
msgid "Gender"
msgstr "Genere"

#: includes/class-camille-ps-admin.php:829
msgid "Woman"
msgstr "Donna"

#: includes/class-camille-ps-admin.php:830
msgid "Man"
msgstr "Uomo"

#: includes/class-camille-ps-admin.php:832
msgid "Photo"
msgstr "Foto"

#: includes/class-camille-ps-admin.php:841
msgid "Your photo"
msgstr "La Sua foto"

#: includes/class-camille-ps-admin.php:846
msgid "Or upload your own photo"
msgstr "Oppure carichi una Sua foto"

#: includes/class-camille-ps-admin.php:847
msgid "JPEG, PNG or WebP, up to 10 MB. It is cut to a square from the centre: choose a portrait with the face in the middle. Use only photos you have the rights to."
msgstr "JPEG, PNG o WebP, fino a 10 MB. Viene ritagliata in un quadrato al centro, quindi scelga un ritratto con il volto in mezzo. Usi solo foto di cui ha i diritti."

#: includes/class-camille-ps-admin.php:849
msgid "Save the personal shopper"
msgstr "Salva la personal shopper"

#: includes/class-camille-ps-admin.php:891
msgid "Which products Camille suggests"
msgstr "Quali prodotti propone Camille"

#: includes/class-camille-ps-admin.php:892
msgid "Choose what Camille may suggest to your customers. Products left out are removed from Camille at the next sync."
msgstr "Scelga cosa può proporre Camille ai Suoi clienti. I prodotti esclusi vengono tolti da Camille alla prossima sincronizzazione."

#: includes/class-camille-ps-admin.php:896
msgid "Categories"
msgstr "Categorie"

#: includes/class-camille-ps-admin.php:898
msgid "Your shop has no product categories."
msgstr "Il negozio non ha categorie di prodotti."

#: includes/class-camille-ps-admin.php:905
msgid "Usually not suited to Camille"
msgstr "Di solito non adatta a Camille"

#: includes/class-camille-ps-admin.php:910
msgid "Leaving out a category also leaves out its subcategories. A product in more than one category stays while at least one of them is selected. Camille works best with clothing, shoes and accessories: perfumes, home items, gift cards and similar products rarely help her build outfits."
msgstr "Escludendo una categoria si escludono anche le sue sottocategorie. Un prodotto presente in più categorie resta finché almeno una è selezionata. Camille dà il meglio con abbigliamento, scarpe e accessori. Profumi, oggetti per la casa, gift card e prodotti simili raramente la aiutano a creare outfit."

#: includes/class-camille-ps-admin.php:912
msgid "Price range"
msgstr "Fascia di prezzo"

#: includes/class-camille-ps-admin.php:914
msgid "From"
msgstr "Da"

#: includes/class-camille-ps-admin.php:915
msgid "to"
msgstr "a"

#: includes/class-camille-ps-admin.php:916
msgid "Leave a field empty for no limit. A product with several prices (variations) stays when at least one price is in the range."
