msgstr "Non hai ancora un account? %s. È gratuito e include 300 crediti per provare Camille."

#. translators: %s: sign-up link.
#: includes/class-camille-ps-admin.php:849
msgid "Create one on pinci.ai"
msgstr "Crealo su pinci.ai"

#. translators: %s: email address.
#: includes/class-camille-ps-admin.php:861
#, php-format
msgid "Enter the 6-digit code sent to %s."
msgstr "Inserisci il codice di 6 cifre inviato a %s."

