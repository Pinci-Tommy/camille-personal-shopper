#: includes/class-camille-ps-admin.php:802
msgid "Camille sections"
msgstr "Sezioni di Camille"

#: includes/class-camille-ps-admin.php:834
msgid "Connect your shop"
msgstr "Collega il negozio"

#: includes/class-camille-ps-admin.php:836
msgid "Camille works with a Pinci account. Enter the email of your account: we will send you a code to confirm it is yours."
msgstr "Camille funziona con un account Pinci. Inserisci l’email del tuo account. Ti invieremo un codice per confermare che è tuo."

#: includes/class-camille-ps-admin.php:840
msgid "Pinci account email"
msgstr "Email dell’account Pinci"

#: includes/class-camille-ps-admin.php:842
msgid "Send the code"
